{
  "expo": {
    "name": "RoutineSync",
    "slug": "RoutineSync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "routinesync",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFBEA",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "pwa": {
        "name": "RoutineSync - Timetable & Alarm Manager",
        "shortName": "RoutineSync",
        "startUrl": "/",
        "display": "standalone",
        "backgroundColor": "#FFFBEA",
        "themeColor": "#FFF384",
        "description": "Smart Routine & Timetable Sync for Noise Smartwatch and Mobile"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF384",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FFF384"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
