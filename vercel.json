{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    {
      "source": "/((?!_expo/|api/|.*\\.(?:js|css|png|jpg|jpeg|gif|ico|json|svg|woff|woff2|ttf|eot)$).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-push",
      "schedule": "*/30 * * * *"
    }
  ]
}
